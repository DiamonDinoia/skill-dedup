#!/usr/bin/env python3
"""Committed stand-in for the uncommitted live hermes-adversarial-review.

Holds only the context lines hooks/hermes-adversarial-review.patch needs plus a
minimal runnable body, so the patched-review tests run on a clean checkout.
"""
import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
HERMES_HOME = Path(os.environ.get("HERMES_HOME") or HOME / ".hermes")


def default_model():
    """$HERMES_REVIEW_MODEL, else the newest *-sol id in the live openai-codex catalog. No literal fallback."""
    return os.environ.get("HERMES_REVIEW_MODEL", "test-model")


INSTRUCTIONS = "fixture instructions"
DEFAULT_EXCLUDES = []
MAX_DIFF_BYTES = 300_000


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(2)


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--repo", default=".")
    ap.add_argument("--exclude", action="append", default=[])
    ap.add_argument("--out")
    ap.add_argument("--model")
    ap.add_argument("--reasoning", default="high")
    a = ap.parse_args()

    patterns = DEFAULT_EXCLUDES + a.exclude
    diff = subprocess.run(["git", "-C", a.repo, "diff", "HEAD", "--"] + patterns,
                          capture_output=True, text=True).stdout
    if len(diff.encode()) > MAX_DIFF_BYTES:
        die(f"hermes-adversarial-review: diff is {len(diff.encode())} bytes (> {MAX_DIFF_BYTES}); split it with --exclude or review per directory")

    reviews = HERMES_HOME / "cache" / "reviews"
    reviews.mkdir(parents=True, exist_ok=True)
    # pid keeps concurrent reviews of the same label from overwriting each other
    out = Path(a.out) if a.out else reviews / f"fixture-{os.getpid()}.md"

    (HERMES_HOME / "cache" / "blind-review").mkdir(parents=True, exist_ok=True)
    work = Path(tempfile.mkdtemp(prefix="run-", dir=HERMES_HOME / "cache" / "blind-review"))
    try:
        qf = work / "query.txt"
        qf.write_text(INSTRUCTIONS + "\n\n=== DIFF START ===\n" + diff + "\n=== DIFF END ===\n")
        # The request dump on disk goes through agent.redact.redact_sensitive_text on the
        # serialized JSON payload (dump writer protection), so the dumped user text equals
        # the redaction of the JSON-escaped query, decoded back. Reproduce that exact text
        # The fixture echoes the prompt into the review file so tests can read it.
        out.write_text(f"model={a.model or default_model()}\nVERDICT: PASS fixture\n{qf.read_text()}")
    finally:
        shutil.rmtree(work, ignore_errors=True)
    print(out)


if __name__ == "__main__":
    main()
